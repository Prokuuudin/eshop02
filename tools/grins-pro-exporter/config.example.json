{
  "mode": "shadow",
  "source": { "dbPath": "C:\\Grins\\Sklad\\DB" },
  "paths": {
    "workDir": "C:\\GrinsProExporter\\work",
    "outputDir": "C:\\GrinsProExporter\\out",
    "logDir": "C:\\GrinsProExporter\\logs",
    "stateDir": "C:\\GrinsProExporter\\state"
