# Hairshop Pro runtime environment template.
# Keep production and staging values separate: use the environment's own database,
# public URL, credentials and secrets. Staging write/integration flags should remain
# false unless a specific isolated test has been approved. Staging must use
# sandbox/disabled payment providers, capture/disabled SMTP, and no production FTPS.
# Operator and test-only variables are documented separately in
# docs/environment-variables-operator-test.md.

# Postgres connection string used by Prisma (both CLI and runtime).
# Supported aliases, in resolution order after DATABASE_URL:
# POSTGRES_PRISMA_URL, POSTGRES_URL, POSTGRES_URL_NON_POOLING.
# Define one source of truth per environment. DIRECT_URL and
# DATABASE_URL_UNPOOLED are NOT read by the current runtime or Prisma config.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Public base URL used for canonical links, Open Graph, JSON-LD, robots and sitemap
# Use the exact URL of this environment, with protocol and no trailing slash.
# Production: https://hairshoppro.lv; staging: https://staging.hairshoppro.lv.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudflare Turnstile (contact form anti-spam)
# Public key used by the client widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key used on server for token verification
TURNSTILE_SECRET_KEY=

# 32 random bytes, base64-encoded — used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# SMTP для отправки email (регистрация, подтверждение)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# Set only for local SMTP capture tools that do not implement STARTTLS.
SMTP_IGNORE_TLS=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Ваш магазин <noreply@example.com>"
# Обязательный production-адрес для сообщений из контактной формы (без fallback)
# Required in production. Generate an independent random secret (for example,
# `openssl rand -hex 32`) and never reuse SMTP_PASS.
NEWSLETTER_UNSUB_SECRET=
CONTACT_TO=contact-recipient@example.com
ADMIN_SETUP_TOKEN=

# Optional comma-separated API keys for /api/v1 integrations. Each entry is
# either a bare key or key:companyId. Use different keys per environment.
V1_API_KEYS=

# Internal Hairshop catalog/taxonomy sync API. The secret must be unique per
# environment. Both write flags fail closed and should remain false on staging.
HAIRSHOP_CATALOG_SYNC_SECRET=
HAIRSHOP_CATALOG_SYNC_WRITE_ENABLED=false
HAIRSHOP_TAXONOMY_SYNC_WRITE_ENABLED=false

# Paysera Checkout Modern (online payment). Obtained from bank.paysera.com/shell/checkout,
# Integrations → API credentials. Client Secret is shown only once — store it immediately.
PAYSERA_PROJECT_ID=
PAYSERA_CLIENT_ID=
PAYSERA_CLIENT_SECRET=
# Customer-facing Paysera switch. Only the exact value "true" shows Paysera at checkout and allows
# new payment links; anything else hides it. The webhook keeps working either way. Read at runtime:
# change it in the server env and recycle the app, no rebuild needed.
PAYSERA_CHECKOUT_ENABLED=false

# PayPal (second online payment gateway, Orders v2 REST API — no SDK).
# https://developer.paypal.com/dashboard/applications — sandbox app for testing, live app for production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com for sandbox, https://api-m.paypal.com for live. No trailing slash.
PAYPAL_API_BASE=
# Webhook ID from the PayPal app's "Webhooks" tab — required to verify /api/webhooks/paypal deliveries.
PAYPAL_WEBHOOK_ID=

# Optional extra header check (X-Admin-Token) for POST /api/admin/orders/send-invoice.
# Leave empty to rely on the existing admin session/permission check only.
ADMIN_API_TOKEN=

# GRINS ERP FTPS export feed (product/stock sync). Not required to run the app —
# only needed once ERP sync is enabled (currently off, see docs/deploy-plesk.md).
GRINS_FTPS_HOST=
GRINS_FTPS_USER=
GRINS_FTPS_PASSWORD=
GRINS_FTPS_REMOTE_PATH=export.xml
# Optional control port (explicit TLS). Empty → 21.
GRINS_FTPS_PORT=
# Empty = one fixed file at GRINS_FTPS_REMOTE_PATH. Set to run-files only when
# the exporter publishes complete export-<runId>.xml + .manifest.json pairs.
GRINS_FTPS_SOURCE_LAYOUT=
# run-files only: remote directory containing the published pairs. Empty = login root.
GRINS_FTPS_REMOTE_DIR=

# FTPS source migration ONLY (docs/erp-ftps-source-migration.md). Read exclusively by
# scripts/verify-ftps-source.ts --source candidate; the scheduled sync never reads these.
# Leave empty outside a migration.
GRINS_FTPS_CANDIDATE_HOST=
GRINS_FTPS_CANDIDATE_USER=
GRINS_FTPS_CANDIDATE_PASSWORD=
GRINS_FTPS_CANDIDATE_REMOTE_PATH=export.xml
GRINS_FTPS_CANDIDATE_PORT=
GRINS_FTPS_CANDIDATE_SOURCE_LAYOUT=
GRINS_FTPS_CANDIDATE_REMOTE_DIR=

# Hourly scheduled FULL sync (scripts/sync-products.ts --scheduled).
# Kill switch: anything other than the exact string "true" makes the scheduled
# run exit 0 without downloading the feed or touching the database.
SYNC_PULL_ENABLED=false
# Price mapping used by full sync. Defaults shown explicitly for auditability.
SYNC_PRIMARY_PRICE_TIER=price2
SYNC_ENABLED_PRICE_TIERS=price1,price2,price3,price4
# Split GrinS stock ledger. Cutover order is documented in
# docs/grins-stock-ledger-handoff-2026-10-12.md. Every flag defaults closed.
GRINS_STOCK_LEDGER_ENABLED=false
GRINS_STOCK_SYNC_ENABLED=false
# Requires export.manifest.json with source-side runStartedAt.
GRINS_STOCK_MANIFEST_ENABLED=false
# Never enable before exporter clock/publication-chain verification.
GRINS_STOCK_RECONCILIATION_ENABLED=false
GRINS_MANIFEST_CLOCK_SKEW_SECONDS=300
GRINS_STOCK_MANIFEST_MAX_AGE_HOURS=3
# Successful snapshot journals retained for a controlled compensating rollback.
GRINS_STOCK_ROLLBACK_RUNS=24
# Recipient of one email per failed scheduled run (uses the SMTP_* settings above).
# Empty → failure is still recorded in SyncRun and logged as erp_sync_alert_skipped.
SYNC_ALERT_EMAIL=

# Private absolute directory for controlled GrinS operator requests and results.
# It must exist outside the application/document root. Leave empty when unused.
GRINS_OPERATIONS_DIR=
