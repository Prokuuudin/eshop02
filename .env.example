# Postgres connection string used by Prisma (both CLI and runtime)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Public base URL used for canonical links, Open Graph, JSON-LD, robots and sitemap
# Use production domain with protocol and no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudflare Turnstile (contact form anti-spam)
# Public key used by the client widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key used on server for token verification
TURNSTILE_SECRET_KEY=

# 32 random bytes, base64-encoded — used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# SMTP для отправки email (регистрация, подтверждение)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# Set only for local SMTP capture tools that do not implement STARTTLS.
SMTP_IGNORE_TLS=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Ваш магазин <noreply@example.com>"
# Адрес, на который приходят сообщения из контактной формы (по умолчанию = SMTP_USER)
# Required in production. Generate an independent random secret (for example,
# `openssl rand -hex 32`) and never reuse SMTP_PASS.
NEWSLETTER_UNSUB_SECRET=
CONTACT_TO=admin@example.com
ADMIN_SETUP_TOKEN=

# Paysera Checkout Modern (online payment). Obtained from bank.paysera.com/shell/checkout,
# Integrations → API credentials. Client Secret is shown only once — store it immediately.
PAYSERA_PROJECT_ID=
PAYSERA_CLIENT_ID=
PAYSERA_CLIENT_SECRET=

# PayPal (second online payment gateway, Orders v2 REST API — no SDK).
# https://developer.paypal.com/dashboard/applications — sandbox app for testing, live app for production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com for sandbox, https://api-m.paypal.com for live. No trailing slash.
PAYPAL_API_BASE=
# Webhook ID from the PayPal app's "Webhooks" tab — required to verify /api/webhooks/paypal deliveries.
PAYPAL_WEBHOOK_ID=

# Optional extra header check (X-Admin-Token) for POST /api/admin/orders/send-invoice.
# Leave empty to rely on the existing admin session/permission check only.
ADMIN_API_TOKEN=

# GRINS ERP FTPS export feed (product/stock sync). Not required to run the app —
# only needed once ERP sync is enabled (currently off, see docs/deploy-plesk.md).
GRINS_FTPS_HOST=
GRINS_FTPS_USER=
GRINS_FTPS_PASSWORD=
GRINS_FTPS_REMOTE_PATH=export.xml
