generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  email               String    @unique
  passwordHash        String
  name                String?
  platformRole        String    @default("customer")
  companyId           String?
  companyName         String?
  teamRole            String?
  // Super Admin: only platform admins with this flag may manage staff (lib/admin-permissions.ts staff.manage).
  superAdmin          Boolean   @default(false)
  approvalRequired    Boolean   @default(false)
  auditLoggingEnabled Boolean   @default(false)
  phone               String?
  cardNumber          String?   @unique
  pkLast3             String?   @db.VarChar(3)
  // One-way proofs retained after GDPR anonymisation so an issued client card
  // can be claimed again without retaining the former account's contact data.
  cardRecoveryEmailHash String?
  cardRecoveryPhoneHash String?
  avatarUrl           String?
  checkoutProfile     Json?
  customerType        String?   @default("individual")
  registrationNumber  String?
  vatNumber           String?
  legalAddress        String?
  bonusPoints         Int       @default(0)
  mustChangePassword  Boolean   @default(false)
  privacyNoticeVersion String?
  privacyAcknowledgedAt DateTime?
  marketingConsent    Boolean   @default(false)
  marketingConsentAt  DateTime?
  notificationChannel String    @default("app")
  notificationsSubscribed Boolean @default(false)
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  mfaBackupCodes      String[]  @default([])
  mfaEnrolledAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  mfaChallenges       MfaChallenge[]
    invitationTokens    InvitationToken[]
    invitationDeliveries InvitationDelivery[]
  accountManagerMessages AccountManagerMessage[]
  userNotifications   UserNotification[]
  bonusTransactions   BonusTransaction[]
  productNewsSubscriptions ProductNewsSubscription[]
  savedAddresses       SavedAddress[]

  @@index([email])
  @@index([companyId])
  @@index([customerType])
  @@index([registrationNumber])
}

  model InvitationToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  email      String
  cardNumber String
  language   String   @default("lv")
  status     String   @default("sent")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([status])
  }

  model InvitationDelivery {
    id        String   @id @default(cuid())
    userId    String
    channel   String
    status    String
    sentAt    DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, channel, sentAt])
    @@index([status, sentAt])
  }

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MfaChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  mfaVerified Boolean @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

model Invoice {
  id              String    @id
  invoiceNumber   String    @unique
  companyId       String
  orderId         String
  subtotal        Decimal   @db.Decimal(12, 2)
  taxRate         Float
  taxAmount       Decimal   @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  status          String    @default("draft")
  issuedDate      DateTime
  dueDate         DateTime
  paidDate        DateTime?
  paymentRecords  Json      @default("[]")
  paidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal   @db.Decimal(12, 2)
  notes           String?
  items           Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
}

model Banner {
  id        String @id
  type      String
  title     String
  subtitle  String @default("")
  image     String @default("")
  link      String @default("")
  ctaLabel  String @default("")
  ctaStyle  String @default("primary")
  bgColor   String @default("")
  textColor String @default("dark")
  active    Boolean @default(true)
  order     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model ContentBlock {
  id        String @id
  type      String
  title     String
  subtitle  String @default("")
  content   String @default("")
  icon      String @default("")
  link      String @default("")
  linkLabel String @default("")
  bgColor   String @default("")
  active    Boolean @default(true)
  order     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model PromoCode {
  id          String   @id
  code        String   @unique
  discount    Float
  discountType String   @default("percentage")
  discountValue Float?
  maxDiscount Float?
  minOrder    Float    @default(0)
  minEligibleAmount Float @default(0)
  maxUses     Int?
  perUserLimit Int?
  usedCount   Int      @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  appliesTo   String   @default("all")
  productIds  String[] @default([])
  brands      String[] @default([])
  categories  String[] @default([])
  subcategories String[] @default([])
  // Product lines (BrandLine ids); a selected line covers its whole subtree.
  brandLineIds String[] @default([])
  excludedProductIds String[] @default([])
  excludeSaleItems Boolean @default(false)
  firstOrderOnly Boolean @default(false)
  active      Boolean  @default(true)
  description String   @default("")
  createdAt   DateTime @default(now())
  redemptions PromoCodeRedemption[]

  @@index([code])
  @@index([active])
}

model PromoCodeRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  orderId     String   @unique
  userId      String?
  email       String
  discount    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, userId])
  @@index([promoCodeId, email])
}

model KeyValueSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Company {
  id                      String          @id
  companyName             String
  cardNumber              String?         @unique
  taxId                   String?
  registrationNumber      String?
  address                 String?
  city                    String?
  country                 String?
  contactPhone            String?
  contactEmail            String?
  accountManagerId        String?
  paymentTermDays         Int             @default(0)
  creditLimit             Decimal?        @db.Decimal(12, 2)
  usedCredit              Decimal         @default(0) @db.Decimal(12, 2)
  approvalWorkflowEnabled Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  members                 CompanyMember[]
  accountManagerMessages  AccountManagerMessage[]

  @@index([cardNumber])
}

model AccountManagerMessage {
  id         String   @id @default(cuid())
  companyId  String
  authorId   String
  senderType String
  text       String
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([authorId])
}

model CompanyMember {
  id        String   @id
  companyId String
  userId    String
  email     String
  role      String   @default("viewer")
  name      String
  addedAt   DateTime @default(now())
  addedBy   String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model OrderStatusRecord {
  orderId   String   @id
  status    String   @default("pending")
  updatedAt DateTime @updatedAt
}

model OrderNote {
  orderId   String   @id
  note      String
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model AuditLog {
  id          String   @id
  sequence    BigInt   @unique @default(autoincrement())
  at          DateTime @default(now())
  adminEmail  String
  adminName   String?
  action      String
  entityType  String
  entityId    String
  entityTitle String?
  before      Json?
  after       Json?
  details     String?
  actorUserId String?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  sessionHash String?
  reason      String?
  previousHash String?
  integrityHash String?

  @@index([adminEmail])
  @@index([action])
  @@index([entityType, entityId])
  @@index([at])
  @@index([requestId])
  @@unique([integrityHash])
}

model Product {
  id                  String   @id
  title               String
  titleKey            String?
  titleEn             String?
  titleLv             String?
  description         String?
  brand               String
  price               Decimal  @db.Decimal(12, 2)
  oldPrice            Decimal? @db.Decimal(12, 2)
  rating              Float    @default(0)
  ratingCount         Int      @default(0)
  reviewCount         Int      @default(0)
  image               String?
  images              String[]
  metaTitle           String?
  metaDescription     String?
  ogImage             String?
  ogAlt               String?
  badges              String[]
  category            String
  stock               Int      @default(0)
  // Last accepted physical stock snapshot from GrinS. Null means the product
  // is not yet managed by the split ERP-stock ledger.
  grinsStock          Int?
  grinsStockUpdatedAt DateTime?
  grinsStockRunId     String?
  barcode             String?
  purpose             String?
  purposeEn           String?
  purposeLv           String?
  relatedProductIds   String[]
  oftenBoughtTogether String[]
  minOrderQuantities  Json?
  technicalSpecs      Json?
  bulkPricingTiers    Json?
  demoVideo           Json?
  distributorName     Json?
  distributorAddress  Json?
  sku                 String?
  revision            Int      @default(1)
  unitOfMeasure       String?
  certificates        String[]
  packagingSize       Int?
  compatibleEquipment String[]
  manufacturerName    String?
  manufacturerAddress String?
  manufacturerEmail   String?
  distributorEmail    String?
  bonusRate           Float?
  feature1            String?
  feature1En          String?
  feature1Lv          String?
  feature2            String?
  feature2En          String?
  feature2Lv          String?
  feature3            String?
  feature3En          String?
  feature3Lv          String?
  feature4            String?
  feature4En          String?
  feature4Lv          String?
  specVolume          String?
  specType            String?
  specCountry         String?
  isCustom            Boolean  @default(false)
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  externalId    String?  @unique
  isActive      Boolean  @default(true)
  lastSyncRunId String?
  // ERP-derived: the linked ERP record has no positive B2B price tier (price2).
  // Maintained by FULL sync; Product.price is then a kept local value, not an ERP price.
  erpPriceMissing     Boolean @default(false)
  // Explicit admin decision to sell at the local Product.price despite erpPriceMissing.
  // Valid only while manualApprovedPrice equals Product.price (the exact approved value).
  // Revoked by sync when ERP supplies a price again and by any manual price change.
  manualPriceApproved Boolean  @default(false)
  manualApprovedPrice Decimal? @db.Decimal(12, 2)
  stockAllocations    StockAllocation[]
  stockSnapshotEntries StockSnapshotEntry[]
  brandLines           ProductBrandLine[]
  grinsStockRun       SyncRun? @relation("ProductGrinsStockRun", fields: [grinsStockRunId], references: [id], onDelete: Restrict)

  @@index([isDeleted])
  @@index([category])
  @@index([isDeleted, category])
  @@index([isDeleted, isActive])
  @@index([lastSyncRunId])
  @@index([grinsStockRunId])
}

model Order {
  id               String   @id
  createdAt        DateTime
  items            Json
  legalDetails     Json?
  subtotal         Decimal  @db.Decimal(12, 2)
  tax              Decimal  @db.Decimal(12, 2)
  delivery         Decimal  @db.Decimal(12, 2)
  trackingNumber   String?
  trackingUrl      String?
  labelUrl         String?
  shipmentCarrier  String?
  country          String   @default("LV")
  deliveryLocation Json?
  deliveryMethod   String
  pickupStoreId    String?
  paymentMethod    String
  promoCode        String?
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  firstName        String
  lastName         String
  email            String
  phone            String
  address          String
  city             String
  postalCode       String?
  bonusSpent       Float?
  bonusEarned      Float?
  paymentStatus    String   @default("unpaid")
  paymentProvider  String?
  paymentSessionId String?
  stockReservationStatus String   @default("committed")
  stockReservedUntil     DateTime?
  stockReleasedAt        DateTime?
  language         String?  @default("ru")
  userId           String?
  companyId        String?
  checkoutKey      String?  @unique
  stockAllocations StockAllocation[]
  operationalExceptions OrderOperationalException[]
  adminNotifications OrderNotificationOutbox[]

  @@index([email])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([stockReservationStatus, stockReservedUntil])
  @@index([userId])
  @@index([companyId])
}

model OrderNotificationOutbox {
  id                    String   @id @default(cuid())
  orderId               String
  notificationType      String
  source                String
  correlationId         String?
  paymentStatusOverride String?
  status                String   @default("pending")
  attempts              Int      @default(0)
  nextAttemptAt         DateTime @default(now())
  lockedAt              DateTime?
  lockToken             String?
  sentAt                DateTime?
  lastErrorCode         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, notificationType])
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
}

model OrderOperationalException {
  id              String   @id @default(cuid())
  orderId         String
  code            String
  status          String   @default("open")
  productIds      Json
  paymentProvider String?
  occurrences     Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, code])
  @@index([status, firstSeenAt])
}

model StockAllocation {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  status              String
  eventKey            String   @unique
  acknowledgmentId    String?  @unique
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  reconciledAt        DateTime?
  reconciledSyncRunId String?
  releasedAt          DateTime?
  releaseReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  order             Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product           Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  reconciledSyncRun SyncRun? @relation("AllocationReconciledRun", fields: [reconciledSyncRunId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([productId, status])
  @@index([status, acknowledgedAt])
  @@index([reconciledSyncRunId])
}

model StockSnapshotEntry {
  runId                   String
  productId               String
  previousGrinsStock      Int?
  previousStock           Int
  previousGrinsStockRunId String?
  incomingGrinsStock      Int
  createdAt               DateTime @default(now())

  run     SyncRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([runId, productId])
  @@index([productId, createdAt])
}

model Review {
  id         String   @id
  productId  String
  author     String
  rating     Int
  title      String
  text       String
  createdAt  DateTime
  helpful    Int      @default(0)
  status     String   @default("approved")
  adminReply Json?
  votes      ReviewHelpfulVote[]

  @@index([productId])
  @@index([productId, status])
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  voterKey  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, voterKey])
  @@index([voterKey])
  @@index([createdAt])
}

model AccessRequest {
  id               String    @id
  email            String
  passwordHash     String
  name             String?
  phone            String?
  companyId        String
  companyName      String
  cardNumber       String
  status           String    @default("pending")
  requestedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedByEmail  String?
  approvedTeamRole String?
  reviewNote       String?
  requestType      String    @default("card")
  certificateName  String?
  message          String?
  language         String?
  privacyNoticeVersion String?
  privacyAcknowledgedAt DateTime?
  marketingConsent Boolean @default(false)
  marketingConsentAt DateTime?

  @@index([email])
  @@index([companyId])
  @@index([status])
  @@index([requestedAt])
}

model SavedAddress {
  id         String  @id
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  firstName  String
  lastName   String
  phone      String
  address    String
  city       String
  postalCode String?

  @@index([email])
  @@index([userId])
}

model ProductNewsSubscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  productTitle String
  notifyPrice  Boolean  @default(true)
  notifyStock  Boolean  @default(true)
  notifyPromo  Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model ReturnRequest {
  id           String    @id
  orderId      String
  createdAt    DateTime  @default(now())
  status       String    @default("pending")
  reason       String
  comment      String?
  items        Json
  refundAmount Decimal  @db.Decimal(12, 2)
  firstName    String
  lastName     String
  email        String
  phone        String
  resolution   String?
  resolvedAt   DateTime?

  @@index([orderId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model RFQRequest {
  id              String   @id
  companyId       String
  items           Json
  notes           String   @default("")
  status          String   @default("pending")
  quote           Json?
  timeline        Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model BlogPost {
  id            String    @id
  slug          String    @unique
  title         String
  excerpt       String
  content       String
  contentBlocks Json?
  author        String
  image         String
  category      String
  readTime      Int       @default(0)
  createdAt     DateTime
  updatedAt     DateTime?
  featured      Boolean   @default(false)
  status        String    @default("published")
  publishedAt   DateTime?
  authorRole    String?
  authorBio     String?
  translations  Json?
  relatedProductIds String[] @default([])

  @@index([status, publishedAt])
}

model AdminRoleChangeRequest {
  id                String   @id @default(cuid())
  targetUserId      String
  requestedByUserId String
  requestedRole     String
  expectedUpdatedAt DateTime
  status            String   @default("pending")
  approvedByUserId  String?
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  resolvedAt        DateTime?

  @@index([status, expiresAt])
  @@index([targetUserId, status])
}

model BonusTransaction {
  id           String   @id @default(cuid())
  userId       String
  orderId      String?
  type         String
  points       Int
  balanceAfter Int
  actorUserId  String?
  reason       String?
  expiresAt    DateTime?
  remainingPoints Int    @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
  @@index([userId, expiresAt])
}

model SyncRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("running")
  productsTotal  Int       @default(0)
  productsSynced Int       @default(0)
  variantsSynced Int       @default(0)
  deactivated    Int       @default(0)
  errorCount     Int       @default(0)
  errorSample    Json?
  triggeredBy    String    @default("cron")
  mode           String    @default("full")
  sourceIdentity String?   @unique
  sourceSha256   String?
  sourceRunStartedAt DateTime?
  sourceGeneratedAt  DateTime?
  grinsStockProducts Product[] @relation("ProductGrinsStockRun")
  reconciledAllocations StockAllocation[] @relation("AllocationReconciledRun")
  stockSnapshotEntries StockSnapshotEntry[]

  @@index([status])
  @@index([startedAt])
  @@index([mode, sourceRunStartedAt])
}

// Hairshop.lv taxonomy sync v2: persistent staging of a begin/batch/finalize
// snapshot. Only a fully verified snapshot is promoted into the
// CatalogSource* mirror. None of these tables touch products, prices, stock,
// promotions or orders.
model TaxonomySnapshotSession {
  id                 String    @id @default(cuid())
  source             String
  runId              String
  mode               String
  // receiving -> completed | rejected | expired
  status             String    @default("receiving")
  manifest           Json
  snapshotSha256     String
  expectedBatchCount Int
  generatedAtUtc     DateTime
  finalizedAt        DateTime?
  // Set in the same transaction that promotes the snapshot into the mirror;
  // the latest appliedAt is the active snapshot.
  appliedAt          DateTime?
  rejectedAt         DateTime?
  lastErrorCode      String?
  lastErrorAt        DateTime?
  errorCount         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  batches            TaxonomySnapshotBatch[]
  categoriesLastSeen CatalogSourceCategory[] @relation("CategoryLastSeenSnapshot")
  categoriesMissingSince CatalogSourceCategory[] @relation("CategoryMissingSinceSnapshot")
  manufacturersLastSeen CatalogSourceManufacturer[] @relation("ManufacturerLastSeenSnapshot")
  manufacturersMissingSince CatalogSourceManufacturer[] @relation("ManufacturerMissingSinceSnapshot")
  productCategoriesLastSeen CatalogSourceProductCategory[] @relation("ProductCategoryLastSeenSnapshot")
  productCategoriesMissingSince CatalogSourceProductCategory[] @relation("ProductCategoryMissingSinceSnapshot")
  productManufacturersLastSeen CatalogSourceProductManufacturer[] @relation("ProductManufacturerLastSeenSnapshot")
  productManufacturersMissingSince CatalogSourceProductManufacturer[] @relation("ProductManufacturerMissingSinceSnapshot")

  @@unique([source, runId])
  @@index([source, status, createdAt])
  @@index([source, appliedAt])
}

model TaxonomySnapshotBatch {
  id            String   @id @default(cuid())
  sessionId     String
  batchId       String
  type          String
  batchIndex    Int
  batchTotal    Int
  checksum      String
  itemCount     Int
  payload       Json
  createdAt     DateTime @default(now())
  session       TaxonomySnapshotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, batchId])
  @@unique([sessionId, type, batchIndex])
}

// Mirror rows are never deleted. A row absent from an applied snapshot keeps
// its data, gets isPresent=false and increments missingSnapshotCount, so a
// single torn (READ COMMITTED) source read is not mistaken for a deletion.
model CatalogSourceCategory {
  source                   String
  sourceCategoryId         String
  parentSourceCategoryId   String?
  names                    Json
  slugs                    Json
  published                Boolean
  sourceCreatedAt          DateTime
  sourceUpdatedAt          DateTime
  isPresent                Boolean  @default(true)
  missingSnapshotCount     Int      @default(0)
  firstSeenAt              DateTime @default(now())
  lastSeenAt               DateTime
  lastSeenSnapshotId       String
  missingSinceAt           DateTime?
  missingSinceSnapshotId   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  parent                   CatalogSourceCategory? @relation("CatalogSourceCategoryHierarchy", fields: [source, parentSourceCategoryId], references: [source, sourceCategoryId], onDelete: Restrict)
  children                 CatalogSourceCategory[] @relation("CatalogSourceCategoryHierarchy")
  lastSeenSnapshot         TaxonomySnapshotSession @relation("CategoryLastSeenSnapshot", fields: [lastSeenSnapshotId], references: [id], onDelete: Restrict)
  missingSinceSnapshot     TaxonomySnapshotSession? @relation("CategoryMissingSinceSnapshot", fields: [missingSinceSnapshotId], references: [id], onDelete: Restrict)
  productMappings          CatalogSourceProductCategory[]
  targetMapping            CatalogSourceCategoryMapping?

  @@id([source, sourceCategoryId])
  @@index([source, parentSourceCategoryId])
  @@index([source, isPresent])
  @@index([lastSeenSnapshotId])
  @@index([missingSinceSnapshotId])
}

model CatalogSourceManufacturer {
  source                   String
  sourceManufacturerId     String
  names                    Json
  slugs                    Json
  published                Boolean
  sourceCreatedAt          DateTime
  sourceUpdatedAt          DateTime
  isPresent                Boolean  @default(true)
  missingSnapshotCount     Int      @default(0)
  firstSeenAt              DateTime @default(now())
  lastSeenAt               DateTime
  lastSeenSnapshotId       String
  missingSinceAt           DateTime?
  missingSinceSnapshotId   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  lastSeenSnapshot         TaxonomySnapshotSession @relation("ManufacturerLastSeenSnapshot", fields: [lastSeenSnapshotId], references: [id], onDelete: Restrict)
  missingSinceSnapshot     TaxonomySnapshotSession? @relation("ManufacturerMissingSinceSnapshot", fields: [missingSinceSnapshotId], references: [id], onDelete: Restrict)
  productMappings          CatalogSourceProductManufacturer[]
  brandMapping             CatalogSourceManufacturerBrand?

  @@id([source, sourceManufacturerId])
  @@index([source, isPresent])
  @@index([lastSeenSnapshotId])
  @@index([missingSinceSnapshotId])
}

// legacyProductId is the nopCommerce Product.Id. It deliberately has no
// foreign key to Product: the source has products that Hairshop Pro does not.
model CatalogSourceProductCategory {
  source                   String
  legacyProductId          String
  sourceCategoryId         String
  displayOrder             Int
  isFeaturedProduct        Boolean
  isPresent                Boolean  @default(true)
  missingSnapshotCount     Int      @default(0)
  firstSeenAt              DateTime @default(now())
  lastSeenAt               DateTime
  lastSeenSnapshotId       String
  missingSinceAt           DateTime?
  missingSinceSnapshotId   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  category                 CatalogSourceCategory @relation(fields: [source, sourceCategoryId], references: [source, sourceCategoryId], onDelete: Restrict)
  lastSeenSnapshot         TaxonomySnapshotSession @relation("ProductCategoryLastSeenSnapshot", fields: [lastSeenSnapshotId], references: [id], onDelete: Restrict)
  missingSinceSnapshot     TaxonomySnapshotSession? @relation("ProductCategoryMissingSinceSnapshot", fields: [missingSinceSnapshotId], references: [id], onDelete: Restrict)

  @@id([source, legacyProductId, sourceCategoryId])
  @@index([source, sourceCategoryId])
  @@index([source, legacyProductId, isPresent])
  @@index([lastSeenSnapshotId])
  @@index([missingSinceSnapshotId])
}

model CatalogSourceProductManufacturer {
  source                   String
  legacyProductId          String
  sourceManufacturerId     String
  displayOrder             Int
  isFeaturedProduct        Boolean
  isPresent                Boolean  @default(true)
  missingSnapshotCount     Int      @default(0)
  firstSeenAt              DateTime @default(now())
  lastSeenAt               DateTime
  lastSeenSnapshotId       String
  missingSinceAt           DateTime?
  missingSinceSnapshotId   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  manufacturer             CatalogSourceManufacturer @relation(fields: [source, sourceManufacturerId], references: [source, sourceManufacturerId], onDelete: Restrict)
  lastSeenSnapshot         TaxonomySnapshotSession @relation("ProductManufacturerLastSeenSnapshot", fields: [lastSeenSnapshotId], references: [id], onDelete: Restrict)
  missingSinceSnapshot     TaxonomySnapshotSession? @relation("ProductManufacturerMissingSinceSnapshot", fields: [missingSinceSnapshotId], references: [id], onDelete: Restrict)

  @@id([source, legacyProductId, sourceManufacturerId])
  @@index([source, sourceManufacturerId])
  @@index([source, legacyProductId, isPresent])
  @@index([lastSeenSnapshotId])
  @@index([missingSinceSnapshotId])
}

model UserNotification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   @default("info")
  title        String
  message      String
  link         String?
  imageUrl     String?
  attachments  Json?
  channel      String   @default("app")
  emailSent    Boolean  @default(false)
  appDelivered Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, appDelivered])
  @@index([createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model MediaAsset {
  name      String   @id
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyApiKey {
  id         String    @id
  companyId  String    @unique
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

