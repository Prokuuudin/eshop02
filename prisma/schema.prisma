generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  email               String    @unique
  passwordHash        String
  name                String?
  platformRole        String    @default("customer")
  companyId           String?
  companyName         String?
  teamRole            String?
  approvalRequired    Boolean   @default(false)
  auditLoggingEnabled Boolean   @default(false)
  phone               String?
  cardNumber          String?   @unique
  pkLast3             String?   @db.VarChar(3)
  // One-way proofs retained after GDPR anonymisation so an issued client card
  // can be claimed again without retaining the former account's contact data.
  cardRecoveryEmailHash String?
  cardRecoveryPhoneHash String?
  avatarUrl           String?
  checkoutProfile     Json?
  customerType        String?   @default("individual")
  registrationNumber  String?
  vatNumber           String?
  legalAddress        String?
  bonusPoints         Int       @default(0)
  mustChangePassword  Boolean   @default(false)
  privacyNoticeVersion String?
  privacyAcknowledgedAt DateTime?
  marketingConsent    Boolean   @default(false)
  marketingConsentAt  DateTime?
  notificationChannel String    @default("app")
  notificationsSubscribed Boolean @default(false)
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  mfaBackupCodes      String[]  @default([])
  mfaEnrolledAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  mfaChallenges       MfaChallenge[]
    invitationTokens    InvitationToken[]
    invitationDeliveries InvitationDelivery[]
  accountManagerMessages AccountManagerMessage[]
  userNotifications   UserNotification[]
  bonusTransactions   BonusTransaction[]
  productNewsSubscriptions ProductNewsSubscription[]
  savedAddresses       SavedAddress[]

  @@index([email])
  @@index([companyId])
  @@index([customerType])
  @@index([registrationNumber])
}

  model InvitationToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  email      String
  cardNumber String
  language   String   @default("lv")
  status     String   @default("sent")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([status])
  }

  model InvitationDelivery {
    id        String   @id @default(cuid())
    userId    String
    channel   String
    status    String
    sentAt    DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, channel, sentAt])
    @@index([status, sentAt])
  }

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MfaChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

model Invoice {
  id              String    @id
  invoiceNumber   String    @unique
  companyId       String
  orderId         String
  subtotal        Decimal   @db.Decimal(12, 2)
  taxRate         Float
  taxAmount       Decimal   @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  status          String    @default("draft")
  issuedDate      DateTime
  dueDate         DateTime
  paidDate        DateTime?
  paymentRecords  Json      @default("[]")
  paidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal   @db.Decimal(12, 2)
  notes           String?
  items           Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
}

model Banner {
  id        String @id
  type      String
  title     String
  subtitle  String @default("")
  image     String @default("")
  link      String @default("")
  ctaLabel  String @default("")
  ctaStyle  String @default("primary")
  bgColor   String @default("")
  textColor String @default("dark")
  active    Boolean @default(true)
  order     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model ContentBlock {
  id        String @id
  type      String
  title     String
  subtitle  String @default("")
  content   String @default("")
  icon      String @default("")
  link      String @default("")
  linkLabel String @default("")
  bgColor   String @default("")
  active    Boolean @default(true)
  order     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model PromoCode {
  id          String   @id
  code        String   @unique
  discount    Float
  discountType String   @default("percentage")
  discountValue Float?
  maxDiscount Float?
  minOrder    Float    @default(0)
  minEligibleAmount Float @default(0)
  maxUses     Int?
  perUserLimit Int?
  usedCount   Int      @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  appliesTo   String   @default("all")
  productIds  String[] @default([])
  brands      String[] @default([])
  categories  String[] @default([])
  subcategories String[] @default([])
  excludedProductIds String[] @default([])
  excludeSaleItems Boolean @default(false)
  firstOrderOnly Boolean @default(false)
  active      Boolean  @default(true)
  description String   @default("")
  createdAt   DateTime @default(now())
  redemptions PromoCodeRedemption[]

  @@index([code])
  @@index([active])
}

model PromoCodeRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  orderId     String   @unique
  userId      String?
  email       String
  discount    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, userId])
  @@index([promoCodeId, email])
}

model KeyValueSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Company {
  id                      String          @id
  companyName             String
  cardNumber              String?         @unique
  taxId                   String?
  registrationNumber      String?
  address                 String?
  city                    String?
  country                 String?
  contactPhone            String?
  contactEmail            String?
  accountManagerId        String?
  paymentTermDays         Int             @default(0)
  creditLimit             Decimal?        @db.Decimal(12, 2)
  usedCredit              Decimal         @default(0) @db.Decimal(12, 2)
  approvalWorkflowEnabled Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  members                 CompanyMember[]
  accountManagerMessages  AccountManagerMessage[]

  @@index([cardNumber])
}

model AccountManagerMessage {
  id         String   @id @default(cuid())
  companyId  String
  authorId   String
  senderType String
  text       String
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([authorId])
}

model CompanyMember {
  id        String   @id
  companyId String
  userId    String
  email     String
  role      String   @default("viewer")
  name      String
  addedAt   DateTime @default(now())
  addedBy   String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model OrderStatusRecord {
  orderId   String   @id
  status    String   @default("pending")
  updatedAt DateTime @updatedAt
}

model OrderNote {
  orderId   String   @id
  note      String
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model AuditLog {
  id          String   @id
  sequence    BigInt   @unique @default(autoincrement())
  at          DateTime @default(now())
  adminEmail  String
  adminName   String?
  action      String
  entityType  String
  entityId    String
  entityTitle String?
  before      Json?
  after       Json?
  details     String?
  actorUserId String?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  sessionHash String?
  reason      String?
  previousHash String?
  integrityHash String?

  @@index([adminEmail])
  @@index([action])
  @@index([entityType, entityId])
  @@index([at])
  @@index([requestId])
  @@unique([integrityHash])
}

model Product {
  id                  String   @id
  title               String
  titleKey            String?
  titleEn             String?
  titleLv             String?
  description         String?
  brand               String
  price               Decimal  @db.Decimal(12, 2)
  oldPrice            Decimal? @db.Decimal(12, 2)
  rating              Float    @default(0)
  ratingCount         Int      @default(0)
  reviewCount         Int      @default(0)
  image               String?
  images              String[]
  metaTitle           String?
  metaDescription     String?
  ogImage             String?
  ogAlt               String?
  badges              String[]
  category            String
  stock               Int      @default(0)
  barcode             String?
  purpose             String?
  purposeEn           String?
  purposeLv           String?
  relatedProductIds   String[]
  oftenBoughtTogether String[]
  minOrderQuantities  Json?
  technicalSpecs      Json?
  bulkPricingTiers    Json?
  demoVideo           Json?
  distributorName     Json?
  distributorAddress  Json?
  sku                 String?
  revision            Int      @default(1)
  unitOfMeasure       String?
  certificates        String[]
  packagingSize       Int?
  compatibleEquipment String[]
  manufacturerName    String?
  manufacturerAddress String?
  manufacturerEmail   String?
  distributorEmail    String?
  bonusRate           Float?
  feature1            String?
  feature1En          String?
  feature1Lv          String?
  feature2            String?
  feature2En          String?
  feature2Lv          String?
  feature3            String?
  feature3En          String?
  feature3Lv          String?
  feature4            String?
  feature4En          String?
  feature4Lv          String?
  specVolume          String?
  specType            String?
  specCountry         String?
  isCustom            Boolean  @default(false)
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  externalId    String?  @unique
  isActive      Boolean  @default(true)
  lastSyncRunId String?
  // ERP-derived: the linked ERP record has no positive B2B price tier (price2).
  // Maintained by FULL sync; Product.price is then a kept local value, not an ERP price.
  erpPriceMissing     Boolean @default(false)
  // Explicit admin decision to sell at the local Product.price despite erpPriceMissing.
  // Valid only while manualApprovedPrice equals Product.price (the exact approved value).
  // Revoked by sync when ERP supplies a price again and by any manual price change.
  manualPriceApproved Boolean  @default(false)
  manualApprovedPrice Decimal? @db.Decimal(12, 2)

  // Competitor pricing (read-only consumers of Product.price; never written by sync).
  competitorMatches      CompetitorProductMatch[]
  pricingRecommendations PricingRecommendation[]

  @@index([isDeleted])
  @@index([category])
  @@index([isDeleted, category])
  @@index([isDeleted, isActive])
  @@index([lastSyncRunId])
}

model Order {
  id               String   @id
  createdAt        DateTime
  items            Json
  legalDetails     Json?
  subtotal         Decimal  @db.Decimal(12, 2)
  tax              Decimal  @db.Decimal(12, 2)
  delivery         Decimal  @db.Decimal(12, 2)
  trackingNumber   String?
  trackingUrl      String?
  labelUrl         String?
  shipmentCarrier  String?
  country          String   @default("LV")
  deliveryLocation Json?
  deliveryMethod   String
  pickupStoreId    String?
  paymentMethod    String
  promoCode        String?
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  firstName        String
  lastName         String
  email            String
  phone            String
  address          String
  city             String
  postalCode       String?
  bonusSpent       Float?
  bonusEarned      Float?
  paymentStatus    String   @default("unpaid")
  paymentProvider  String?
