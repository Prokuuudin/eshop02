generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  email               String    @unique
  passwordHash        String
  name                String?
  platformRole        String    @default("customer")
  companyId           String?
  companyName         String?
  teamRole            String?
  approvalRequired    Boolean   @default(false)
  auditLoggingEnabled Boolean   @default(false)
  phone               String?
  cardNumber          String?   @unique
  pkLast3             String?   @db.VarChar(3)
  avatarUrl           String?
  checkoutProfile     Json?
  customerType        String?   @default("individual")
  registrationNumber  String?
  vatNumber           String?
  legalAddress        String?
  bonusPoints         Int       @default(350)
  mustChangePassword  Boolean   @default(false)
  privacyNoticeVersion String?
  privacyAcknowledgedAt DateTime?
  marketingConsent    Boolean   @default(false)
  marketingConsentAt  DateTime?
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  mfaBackupCodes      String[]  @default([])
  mfaEnrolledAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  mfaChallenges       MfaChallenge[]
  invitationTokens    InvitationToken[]
  accountManagerMessages AccountManagerMessage[]
  userNotifications   UserNotification[]
  bonusTransactions   BonusTransaction[]
  productNewsSubscriptions ProductNewsSubscription[]

  @@index([email])
  @@index([companyId])
  @@index([customerType])
  @@index([registrationNumber])
}

model InvitationToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  email      String
  cardNumber String
  language   String   @default("lv")
  status     String   @default("sent")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MfaChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

model Invoice {
  id              String    @id
  invoiceNumber   String    @unique
  companyId       String
  orderId         String
  subtotal        Decimal   @db.Decimal(12, 2)
  taxRate         Float
  taxAmount       Decimal   @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  status          String    @default("draft")
  issuedDate      DateTime
  dueDate         DateTime
  paidDate        DateTime?
  paymentRecords  Json      @default("[]")
  paidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal   @db.Decimal(12, 2)
  notes           String?
  items           Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
}

model Banner {
  id        String @id
  type      String
  title     String
  subtitle  String @default("")
  image     String @default("")
  link      String @default("")
  ctaLabel  String @default("")
  ctaStyle  String @default("primary")
  bgColor   String @default("")
  textColor String @default("dark")
  active    Boolean @default(true)
  order     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model ContentBlock {
  id        String @id
  type      String
  title     String
  subtitle  String @default("")
  content   String @default("")
  icon      String @default("")
  link      String @default("")
  linkLabel String @default("")
  bgColor   String @default("")
  active    Boolean @default(true)
  order     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model PromoCode {
  id          String   @id
  code        String   @unique
  discount    Float
  discountType String   @default("percentage")
  discountValue Float?
  maxDiscount Float?
  minOrder    Float    @default(0)
  minEligibleAmount Float @default(0)
  maxUses     Int?
  perUserLimit Int?
  usedCount   Int      @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  appliesTo   String   @default("all")
  productIds  String[] @default([])
  brands      String[] @default([])
  categories  String[] @default([])
  subcategories String[] @default([])
  excludedProductIds String[] @default([])
  excludeSaleItems Boolean @default(false)
  firstOrderOnly Boolean @default(false)
  active      Boolean  @default(true)
  description String   @default("")
  createdAt   DateTime @default(now())
  redemptions PromoCodeRedemption[]

  @@index([code])
  @@index([active])
}

model PromoCodeRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  orderId     String   @unique
  userId      String?
  email       String
  discount    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, userId])
  @@index([promoCodeId, email])
}

model KeyValueSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Company {
  id                      String          @id
  companyName             String
  cardNumber              String?         @unique
  taxId                   String?
  registrationNumber      String?
  address                 String?
  city                    String?
  country                 String?
  contactPhone            String?
  contactEmail            String?
  accountManagerId        String?
  paymentTermDays         Int             @default(0)
  creditLimit             Decimal?        @db.Decimal(12, 2)
  usedCredit              Decimal         @default(0) @db.Decimal(12, 2)
  approvalWorkflowEnabled Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  members                 CompanyMember[]
  accountManagerMessages  AccountManagerMessage[]

  @@index([cardNumber])
}

model AccountManagerMessage {
  id         String   @id @default(cuid())
  companyId  String
  authorId   String
  senderType String
  text       String
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([authorId])
}

model CompanyMember {
  id        String   @id
  companyId String
  userId    String
  email     String
  role      String   @default("viewer")
  name      String
  addedAt   DateTime @default(now())
  addedBy   String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model OrderStatusRecord {
  orderId   String   @id
  status    String   @default("pending")
  updatedAt DateTime @updatedAt
}

model OrderNote {
  orderId   String   @id
  note      String
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model AuditLog {
  id          String   @id
  sequence    BigInt   @unique @default(autoincrement())
  at          DateTime @default(now())
  adminEmail  String
  adminName   String?
  action      String
  entityType  String
  entityId    String
  entityTitle String?
  before      Json?
  after       Json?
  details     String?
  actorUserId String?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  sessionHash String?
  reason      String?
  previousHash String?
  integrityHash String?

  @@index([adminEmail])
  @@index([action])
  @@index([entityType, entityId])
  @@index([at])
  @@index([requestId])
  @@unique([integrityHash])
}

model Product {
  id                  String   @id
  title               String
  titleKey            String?
  titleEn             String?
  titleLv             String?
  description         String?
  brand               String
  price               Decimal  @db.Decimal(12, 2)
  oldPrice            Decimal? @db.Decimal(12, 2)
  rating              Float    @default(0)
  ratingCount         Int      @default(0)
  reviewCount         Int      @default(0)
  image               String?
  images              String[]
  metaTitle           String?
  metaDescription     String?
  ogImage             String?
  ogAlt               String?
  badges              String[]
  category            String
  stock               Int      @default(0)
  barcode             String?
  purpose             String?
  purposeEn           String?
  purposeLv           String?
  relatedProductIds   String[]
  oftenBoughtTogether String[]
  minOrderQuantities  Json?
  technicalSpecs      Json?
  bulkPricingTiers    Json?
  demoVideo           Json?
  distributorName     Json?
  distributorAddress  Json?
  sku                 String?
  revision            Int      @default(1)
  unitOfMeasure       String?
  certificates        String[]
  packagingSize       Int?
  compatibleEquipment String[]
  manufacturerName    String?
  manufacturerAddress String?
  manufacturerEmail   String?
  distributorEmail    String?
  bonusRate           Float?
  feature1            String?
  feature1En          String?
  feature1Lv          String?
  feature2            String?
  feature2En          String?
  feature2Lv          String?
  feature3            String?
  feature3En          String?
  feature3Lv          String?
  feature4            String?
  feature4En          String?
  feature4Lv          String?
  specVolume          String?
  specType            String?
  specCountry         String?
  isCustom            Boolean  @default(false)
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  externalId    String?  @unique
  isActive      Boolean  @default(true)
  lastSyncRunId String?

  @@index([isDeleted])
  @@index([category])
  @@index([isDeleted, category])
  @@index([isDeleted, isActive])
  @@index([lastSyncRunId])
}

model Order {
  id               String   @id
  createdAt        DateTime
  items            Json
  legalDetails     Json?
  subtotal         Decimal  @db.Decimal(12, 2)
  tax              Decimal  @db.Decimal(12, 2)
  delivery         Decimal  @db.Decimal(12, 2)
  deliveryMethod   String
  paymentMethod    String
  promoCode        String?
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  firstName        String
  lastName         String
  email            String
  phone            String
  address          String
  city             String
  postalCode       String?
  bonusSpent       Float?
  bonusEarned      Float?
  paymentStatus    String   @default("unpaid")
  paymentProvider  String?
  paymentSessionId String?
  stockReservationStatus String   @default("committed")
  stockReservedUntil     DateTime?
  stockReleasedAt        DateTime?
  language         String?  @default("ru")
  userId           String?
  companyId        String?

  @@index([email])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([stockReservationStatus, stockReservedUntil])
  @@index([userId])
  @@index([companyId])
}

model Review {
  id         String   @id
  productId  String
  author     String
  rating     Int
  title      String
  text       String
  createdAt  DateTime
  helpful    Int      @default(0)
  status     String   @default("approved")
  adminReply Json?
  votes      ReviewHelpfulVote[]

  @@index([productId])
  @@index([productId, status])
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  voterKey  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, voterKey])
  @@index([voterKey])
  @@index([createdAt])
}

model AccessRequest {
  id               String    @id
  email            String
  passwordHash     String
  name             String?
  phone            String?
  companyId        String
  companyName      String
  cardNumber       String
  status           String    @default("pending")
  requestedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedByEmail  String?
  approvedTeamRole String?
  reviewNote       String?
  requestType      String    @default("card")
  certificateName  String?
  message          String?
  language         String?
  privacyNoticeVersion String?
  privacyAcknowledgedAt DateTime?
  marketingConsent Boolean @default(false)
  marketingConsentAt DateTime?

  @@index([email])
  @@index([companyId])
  @@index([status])
  @@index([requestedAt])
}

model SavedAddress {
  id         String  @id
  email      String
  firstName  String
  lastName   String
  phone      String
  address    String
  city       String
  postalCode String?

  @@index([email])
}

model ProductNewsSubscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  productTitle String
  notifyPrice  Boolean  @default(true)
  notifyStock  Boolean  @default(true)
  notifyPromo  Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model ReturnRequest {
  id           String    @id
  orderId      String
  createdAt    DateTime  @default(now())
  status       String    @default("pending")
  reason       String
  comment      String?
  items        Json
  refundAmount Decimal  @db.Decimal(12, 2)
  firstName    String
  lastName     String
  email        String
  phone        String
  resolution   String?
  resolvedAt   DateTime?

  @@index([orderId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model RFQRequest {
  id              String   @id
  companyId       String
  items           Json
  notes           String   @default("")
  status          String   @default("pending")
  quote           Json?
  timeline        Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model BlogPost {
  id            String    @id
  slug          String    @unique
  title         String
  excerpt       String
  content       String
  contentBlocks Json?
  author        String
  image         String
  category      String
  readTime      Int       @default(0)
  createdAt     DateTime
  updatedAt     DateTime?
  featured      Boolean   @default(false)
  status        String    @default("published")
  publishedAt   DateTime?
  authorRole    String?
  authorBio     String?
  translations  Json?

  @@index([status, publishedAt])
}

model AdminRoleChangeRequest {
  id                String   @id @default(cuid())
  targetUserId      String
  requestedByUserId String
  requestedRole     String
  expectedUpdatedAt DateTime
  status            String   @default("pending")
  approvedByUserId  String?
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  resolvedAt        DateTime?

  @@index([status, expiresAt])
  @@index([targetUserId, status])
}

model BonusTransaction {
  id           String   @id @default(cuid())
  userId       String
  orderId      String?
  type         String
  points       Int
  balanceAfter Int
  actorUserId  String?
  reason       String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
}

model SyncRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("running")
  productsTotal  Int       @default(0)
  productsSynced Int       @default(0)
  variantsSynced Int       @default(0)
  deactivated    Int       @default(0)
  errorCount     Int       @default(0)
  errorSample    Json?
  triggeredBy    String    @default("cron")

  @@index([status])
  @@index([startedAt])
}

model UserNotification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   @default("info")
  title        String
  message      String
  link         String?
  channel      String   @default("app")
  emailSent    Boolean  @default(false)
  appDelivered Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, appDelivered])
  @@index([createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model MediaAsset {
  name      String   @id
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyApiKey {
  id         String    @id
  companyId  String    @unique
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([companyId])
}

model ContactMessage {
  id           String    @id
  name         String
  email        String
  subject      String
  message      String
  ipAddress    String?
  emailStatus  String    @default("pending")
  emailError   String?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}

model CompanyActivityLog {
  id        String   @id
  companyId String
  userId    String
  userName  String?
  userEmail String?
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model WebhookEndpoint {
  id        String   @id
  companyId String
  url       String
  events    Json     @default("[]")
  isActive  Boolean  @default(true)
  secret    String
  createdAt DateTime @default(now())

  @@index([companyId])
}

model WebhookDeliveryLog {
  id        String   @id
  companyId String
  event     String
  payload   Json
  attempts  Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}
