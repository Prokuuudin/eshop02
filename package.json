{
  "name": "hairshoppro.lv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "dev": "next dev --webpack",
    "build": "prisma migrate deploy && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:encoding": "node scripts/check-public-text-encoding.mjs",
    "check:admin-i18n": "node scripts/check-admin-i18n.mjs",
    "check:admin-i18n:strict": "node scripts/check-admin-i18n.mjs --strict",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:admin-i18n": "playwright test e2e/admin-locales.spec.ts --project=chromium --workers=1",
    "test:e2e:smoke": "playwright test e2e/critical-flows.spec.ts e2e/admin-flows.spec.ts e2e/admin-rbac.spec.ts e2e/wishlist.spec.ts e2e/demo-b2b-invoices.spec.ts --project=chromium --workers=1",
    "test:e2e:smoke:critical": "playwright test e2e/critical-flows.spec.ts --project=chromium",
    "test:e2e:smoke:admin": "playwright test e2e/admin-flows.spec.ts e2e/admin-rbac.spec.ts --project=chromium",
    "test:e2e:smoke:account": "playwright test e2e/wishlist.spec.ts e2e/demo-b2b-invoices.spec.ts --project=chromium",
    "test:e2e:smoke:firefox": "playwright test e2e/cross-browser-responsive.spec.ts --project=firefox --workers=1",
    "test:email:delivery": "tsx scripts/verify-email-delivery.ts",
    "audit:security": "node scripts/security-audit.mjs",
    "audit:architecture": "node scripts/architecture-audit.mjs",
    "test:load:smoke": "node scripts/load-smoke.mjs",
    "test:erp:performance": "tsx scripts/benchmark-erp-parser.ts",
    "test:restore": "tsx scripts/verify-restore.ts",
    "import:client-types": "tsx scripts/import-client-types.ts",
    "test:search-plan": "tsx scripts/check-search-plan.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/he": "^1.2.3",
    "@types/pg": "^8.20.0",
    "basic-ftp": "^6.0.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "he": "^1.2.0",
    "jose": "^6.2.3",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.574.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.74.0",
    "react-phone-number-input": "^3.4.16",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.21.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.20",
    "@prisma/dev": "0.24.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "autoprefixer": "10.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "mssql": "^12.5.5",
    "postcss": "8.5.20",
    "prettier": "2.8.8",
    "tailwindcss": "3.4.0",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
