# Postgres connection string used by Prisma (both CLI and runtime)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Public base URL used for canonical links, Open Graph, JSON-LD, robots and sitemap
# Use production domain with protocol and no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudflare Turnstile (contact form anti-spam)
# Public key used by the client widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key used on server for token verification
TURNSTILE_SECRET_KEY=

# Stripe payments (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Универсальный первый пароль для новых клиентов (обязателен к смене при первом входе)
# Server-only — НЕ добавлять префикс NEXT_PUBLIC_, иначе значение попадёт в JS-бандл браузера
FIRST_LOGIN_PASSWORD=Welcome1!Change

# 32 random bytes, base64-encoded — used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# SMTP для отправки email (регистрация, подтверждение)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# Set only for local SMTP capture tools that do not implement STARTTLS.
SMTP_IGNORE_TLS=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Ваш магазин <noreply@example.com>"
# Адрес, на который приходят сообщения из контактной формы (по умолчанию = SMTP_USER)
# Required in production. Generate an independent random secret (for example,
# `openssl rand -hex 32`) and never reuse SMTP_PASS.
NEWSLETTER_UNSUB_SECRET=
CONTACT_TO=admin@example.com
